+  let within9 = 0;
+  let nearest = Infinity;
+  for (let x = c[0] - 1; x <= c[0] + 1; x++)
+    for (let y = c[1] - 1; y <= c[1] + 1; y++)
+      for (let z = c[2] - 1; z <= c[2] + 1; z++)
+        for (const a of grid.get(key(x, y, z)) ?? []) {
+          const d = Math.hypot(a[0] - p[0], a[1] - p[1], a[2] - p[2]);
