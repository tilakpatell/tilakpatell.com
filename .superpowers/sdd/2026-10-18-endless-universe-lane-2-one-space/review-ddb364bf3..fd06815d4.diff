+// One star system, made from its seed alone, so the sector generator (and a
+// later one that stacks sectors in 3D) builds every system the same way: the
+// star, who holds it, its planets; then the moons, ring bands and reach that
+// the flight and the map need. Moons and rings have streams of their own, so
+// a planet's own stream is never touched. Pure (no three.js).
+//
+// cultureOf(rng, d) → 'core' | 'rim' | 'drift', by distance d from the middle
+// localFactions(rng, id, d) → [{ id: '<sector id>:f<k>', name }]
+// systemAt(sSeed, { id, i, at, d, band, local }) → a system (sector.js's
+//   shape); id is the sector's, at is the system's place, height included
+// planetsOf(sysId, sysSeed, at, star, culture) → the planets
+// moonsOf(planet) → [{ id: '<planet id>:k', k, name, type: 'rocky' | 'icy',
+//   seed, radius, orbit, phase, revs, tilt }]
+// ringBandOf(planet) → { inner, outer } | null
+// systemReach(system) → how far from its star anything in it reaches
+// addBodies(sector) → a copy whose systems have reach and whose planets have
+//   centre, revs, moonList and ringBand; nothing it had changes
+
+import { designation, nameOf } from "./names";
+import { revsFor } from "./orbits";
+import {
+  hash64,
+  int,
+  moonSeed,
+  pick,
+  planetSeed,
+  range,
+  rngOf,
+  weighted,
+} from "./seed";
+import {
+  FACTION_KINDS,
+  PLANET_TYPES,
+  STAR_CLASSES,
+  hazardWeights,
+} from "./tables";
+
+const ORBIT_MAX = 2600;
+const ICY = { ice: 0.8, gas: 0.5, ringed: 0.6 };
+const NUMERALS = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII"];
+
+const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
+
+export function cultureOf(rng, d) {
+  if (d <= 2) return "core";
+  if (d <= 6) return rng() < 0.15 * (d - 2) - 0.1 ? "drift" : "rim";
+  return rng() < 0.15 ? "rim" : "drift";
+}
+
+export function localFactions(rng, id, d) {
+  return Array.from({ length: int(rng, 1, 2) }, (_, k) => {
+    const name = `${nameOf(rng, cultureOf(rng, d))} ${pick(rng, FACTION_KINDS)}`;
+    return { id: `${id}:f${k}`, name };
+  });
+}
+
+export function planetsOf(sysId, sysSeed, at, star, culture) {
+  const rng = rngOf(hash64(sysSeed, "planets"));
+  const want = int(rng, 1, 7);
+  const planets = [];
+  let orbit = star.size * 3,
+    lastR = 0;
+  for (let j = 0; j < want; j++) {
+    const seed = planetSeed(sysSeed, j);
+    const pr = rngOf(seed);
+    const kind = weighted(pr, PLANET_TYPES);
+    const radius = Math.round(range(pr, ...kind.radius));
+    if (j) orbit += 2 * Math.max(radius, lastR) + range(pr, 40, 400);
+    if (orbit > ORBIT_MAX) break;
+    const a = pr() * Math.PI * 2;
+    planets.push({
+      id: `${sysId}:${j}`,
+      name: nameOf(pr, culture),
+      type: kind.type,
+      radius,
+      color: pick(pr, kind.colors),
+      at: [
+        at[0] + Math.cos(a) * orbit,
+        at[1] + range(pr, -40, 40),
+        at[2] + Math.sin(a) * orbit,
+      ],
+      orbit,
+      moons: int(pr, ...kind.moons),
+      rings: pr() < kind.rings,
+      seed,
+    });
+    lastR = radius;
+  }
+  return planets;
+}
+
+export function systemAt(sSeed, { id, i, at, d, band, local }) {
+  const sr = rngOf(sSeed);
+  const culture = cultureOf(sr, d);
+  const cls = weighted(sr, STAR_CLASSES);
+  const star = {
+    class: cls.class,
+    color: cls.color,
+    size: Math.round(range(sr, ...cls.size)),
+  };
+  const f = weighted(sr, band);
+  const faction =
+    f.id === "generated" ? pick(sr, local) : { id: f.id, name: f.name };
+  const sysId = `${id}:${i}`;
+  return {
+    id: sysId,
+    i,
+    name: nameOf(sr, culture),
+    designation: designation(sr),
+    at,
+    seed: sSeed,
+    culture,
+    star,
+    planets: planetsOf(sysId, sSeed, at, star, culture),
+    faction,
+    traffic: clamp(0.9 - 0.08 * d + range(sr, -0.15, 0.15), 0.05, 1),
+    hazard: weighted(sr, hazardWeights(d), ([, w]) => w)[0],
+  };
+}
+
+// its own stream, so the planet's is the same whether or not it has rings
+export function ringBandOf(planet) {
+  if (!planet.rings) return null;
+  const rng = rngOf(hash64(planet.seed, "rings"));
+  const r = planet.radius;
+  const inner = range(rng, 1.3, 1.6) * r;
+  const outer = inner + range(rng, 0.2 * r, 2.4 * r - inner);
+  return { inner, outer };
+}
+
+// the moons share the span between the rings (or 1.8 r) and 4.4 r, one slot
+// each, so their orbits can only rise
+export function moonsOf(planet) {
+  const r = planet.radius;
+  const ring = ringBandOf(planet);
+  const lo = Math.max(1.8 * r, ring ? ring.outer : 0);
+  const slot = (4.4 * r - lo) / (planet.moons || 1);
+  const moons = [];
+  for (let k = 0; k < planet.moons; k++) {
+    const seed = moonSeed(planet.seed, k);
+    const rng = rngOf(seed);
+    const orbit = lo + (k + range(rng, 0.2, 1)) * slot;
+    moons.push({
+      id: `${planet.id}:${k}`,
+      k,
+      name: `${planet.name} ${NUMERALS[k]}`,
+      type: rng() < (ICY[planet.type] ?? 0.15) ? "icy" : "rocky",
+      seed,
+      radius: Math.max(3, range(rng, 0.08, 0.25) * r),
+      orbit,
+      phase: rng() * Math.PI * 2,
+      revs: revsFor(orbit),
+      tilt: range(rng, -0.35, 0.35),
+    });
+  }
+  return moons;
+}
+
+export function systemReach(system) {
+  let reach = system.star.size * 3;
+  for (const p of system.planets) {
+    const last = p.moonList?.at(-1);
+    const out = Math.max(
+      p.radius,
+      p.ringBand ? p.ringBand.outer : 0,
+      last ? last.orbit + last.radius : 0,
+    );
+    reach = Math.max(reach, p.orbit + out);
+  }
+  return reach;
+}
+
+export function addBodies(sector) {
+  return {
+    ...sector,
+    systems: sector.systems.map((s) => {
+      const planets = s.planets.map((p) => ({
+        ...p,
+        centre: s.at,
+        revs: revsFor(p.orbit),
+        moonList: moonsOf(p),
+        ringBand: ringBandOf(p),
+      }));
+      const withBodies = { ...s, planets };
+      return { ...withBodies, reach: systemReach(withBodies) };
+    }),
+  };
+}
diff --git a/src/components/expanse/gen/systems.test.js b/src/components/expanse/gen/systems.test.js
new file mode 100644
index 000000000..edeec5e84
--- /dev/null
+++ b/src/components/expanse/gen/systems.test.js
@@ -0,0 +1,120 @@
+import { describe, expect, it } from "vitest";
+import { PRINTED, plainSector } from "./fixtures/fingerprint";
+import { revsFor } from "./orbits";
+import { UNIVERSE, hash64, moonSeed, sectorSeed, sectorSeedOf } from "./seed";
+import { makeSector } from "./sector";
+import { addBodies, moonsOf, ringBandOf, systemReach } from "./systems";
+
+const raw = PRINTED.map(([sx, sz]) => makeSector(UNIVERSE, sx, sz));
+const made = raw.map(addBodies);
+const systems = made.flatMap((s) => s.systems);
+const planets = systems.flatMap((s) => s.planets.map((p) => [s, p]));
+
+describe("seeds", () => {
+  it("moonSeed and sectorSeedOf", () => {
+    expect(moonSeed(5n, 2)).toBe(hash64(5n, "moon", 2));
+    expect(sectorSeedOf(UNIVERSE, 3, 0, -2)).toBe(sectorSeed(UNIVERSE, 3, -2));
+    expect(sectorSeedOf(UNIVERSE, 3, 1, -2)).not.toBe(
+      sectorSeed(UNIVERSE, 3, -2),
+    );
+  });
+});
+
+describe("addBodies", () => {
+  it("has planets to test", () => {
+    expect(planets.length).toBeGreaterThan(100);
+  });
+  it("changes no existing field and does not touch its input", () => {
+    made.forEach((m, n) => {
+      expect(plainSector(m)).toEqual(plainSector(raw[n]));
+    });
+    expect(raw[0].systems[0].reach).toBeUndefined();
+    expect(raw[0].systems[0].planets[0].moonList).toBeUndefined();
+  });
+  it("gives every planet its centre and revs", () => {
+    for (const [s, p] of planets) {
+      expect(p.centre).toEqual(s.at);
+      expect(p.revs).toBe(revsFor(p.orbit));
+    }
+  });
+});
+
+describe("moonsOf", () => {
+  it("makes the moons the planet says", () => {
+    for (const [, p] of planets) {
+      expect(p.moonList).toHaveLength(p.moons);
+      p.moonList.forEach((m, k) => {
+        expect(m.id).toBe(`${p.id}:${k}`);
+        expect(m.k).toBe(k);
+        expect(m.name).toBe(`${p.name} ${["I", "II", "III", "IV", "V", "VI"][k]}`);
+        expect(["rocky", "icy"]).toContain(m.type);
+        expect(m.seed).toBe(moonSeed(p.seed, k));
+        expect(m.revs).toBe(revsFor(m.orbit));
+        expect(m.phase).toBeGreaterThanOrEqual(0);
+        expect(m.phase).toBeLessThan(2 * Math.PI);
+        expect(Math.abs(m.tilt)).toBeLessThanOrEqual(0.35);
+        expect(m.radius).toBeGreaterThanOrEqual(3);
+        expect(m.radius).toBeLessThanOrEqual(0.25 * p.radius + 3);
+      });
+    }
+  });
+  it("keeps the orbits rising, clear of the planet and its rings", () => {
+    for (const [, p] of planets) {
+      let last = Math.max(1.8 * p.radius, p.ringBand ? p.ringBand.outer : 0);
+      for (const m of p.moonList) {
+        expect(m.orbit).toBeGreaterThan(last);
+        last = m.orbit;
+      }
+      expect(last).toBeLessThanOrEqual(4.4 * p.radius);
+    }
+  });
+  it("is icier round cold planets", () => {
+    const share = (types) => {
+      const ms = planets
+        .filter(([, p]) => types.includes(p.type))
+        .flatMap(([, p]) => p.moonList);
+      return ms.filter((m) => m.type === "icy").length / ms.length;
+    };
+    expect(share(["ice", "gas", "ringed"])).toBeGreaterThan(
+      share(["rock", "lava", "desert"]),
+    );
+  });
+  it("is pure", () => {
+    const [, p] = planets.find(([, q]) => q.moons > 1);
+    expect(moonsOf(p)).toEqual(moonsOf(p));
+    expect(moonsOf(p)).toEqual(p.moonList);
+  });
+});
+
+describe("ringBandOf", () => {
+  it("is null unless the planet has rings, else within 1.3 to 2.4 radii", () => {
+    for (const [, p] of planets) {
+      const b = ringBandOf(p);
+      if (!p.rings) expect(b).toBeNull();
+      else {
+        expect(b.inner).toBeGreaterThanOrEqual(1.3 * p.radius);
+        expect(b.inner).toBeLessThan(b.outer);
+        expect(b.outer).toBeLessThanOrEqual(2.4 * p.radius);
+      }
+    }
+    expect(planets.some(([, p]) => p.rings)).toBe(true);
+  });
+});
+
+describe("systemReach", () => {
+  it("covers the star, every planet, its rings and its last moon", () => {
+    for (const s of systems) {
+      expect(s.reach).toBe(systemReach(s));
+      expect(s.reach).toBeGreaterThanOrEqual(s.star.size * 3);
+      for (const p of s.planets) {
+        const last = p.moonList.at(-1);
+        const out = Math.max(
+          p.radius,
+          p.ringBand ? p.ringBand.outer : 0,
+          last ? last.orbit + last.radius : 0,
+        );
+        expect(s.reach).toBeGreaterThanOrEqual(p.orbit + out);
+      }
+    }
+  });
+});
diff --git a/src/components/expanse/gen/things.js b/src/components/expanse/gen/things.js
new file mode 100644
index 000000000..4f0727dfc
--- /dev/null
+++ b/src/components/expanse/gen/things.js
@@ -0,0 +1,205 @@
+// The small things of a sector: a 20 x 20 x 20 lattice of cells, each with at
+// most one rock, ice, derelict or rogue, so space is populated in every
+// direction. The cell's slot and a 32-bit hash of the sector seed fix what
+// sits in it, so any one cell can be rebuilt alone, in any order, and give
+// what the whole list gives. Pure (no three.js), so it runs in Node.
+//
+// THING_BASE (wonder ids from here up are lattice slots), THING_CELLS, THING_JITTER, THING_NEAR
+// THING_KINDS: the table of kinds, { kind, weight, size: [least, most], look: { color, lit }, place?(site, ctx) }
+//   (place may return a new [x, y, z] in absolute space or null to drop the site; it runs before the clearance checks)
+// SECTOR_EXTRAS: whole-sector lists { list, base, max, make(ctx) → [{ kind, at, size, ... }] }
+// thingsOf(ctx, extras = SECTOR_EXTRAS, kinds = THING_KINDS) → { things: ThingSet, extras: { [list]: Row[] } }
+//   ctx is { sx, sy, sz, origin, seed, systems, outs }
+//   ThingSet is { count, slot: Uint16Array, kind: Uint8Array (index into kinds), at: Float32Array (xyz from the origin), size: Float32Array }
+// thingInCell(ctx, slot, kinds = THING_KINDS) → { kind (index), at (from the origin), size } | null
+//   (cells run in slot order ix + 20 * (iy + 20 * iz), centre = origin - 57000 + 6000 * (ix, iy, iz))
+// thingSeed(sectorSeed, n) → bigint
+// thingRow(sector, i) → { id, n, kind (name), at (absolute), size, seed, name }
+//   (sector carries { sx, sy, sz, origin, seed, things })
+
+import { SECTOR, spaceId } from '../../../lib/space/address.js';
+import { clearOfKeepOuts } from './keepOuts';
+import { nameOf } from './names';
+import { hash64, rngOf } from './seed';
+import { systemReach } from './systems';
+
+export const THING_BASE = 64;
+export const THING_CELLS = 20;
+export const THING_JITTER = 0.8;
+export const THING_NEAR = 8;
+
+export const THING_KINDS = [
+  { kind: 'rock', weight: 6, size: [20, 120], look: { color: '#8a8178', lit: true } },
+  { kind: 'ice', weight: 2, size: [15, 90], look: { color: '#cfe3ee', lit: true } },
+  { kind: 'derelict', weight: 1, size: [30, 140], look: { color: '#6d727c', lit: true } },
+  { kind: 'rogue', weight: 0.4, size: [100, 260], look: { color: '#4a3f38', lit: true } },
+];
+
+export const SECTOR_EXTRAS = [];
+
+const CELL = SECTOR / THING_CELLS;
+const HALF = CELL / 2;
+const SLOTS = THING_CELLS ** 3;
+const SKIN = SECTOR / 2 + CELL; // systems further out than this can't touch a thing
+const BUCKET = 12000;
+
+export const thingSeed = (sectorSeed, n) => hash64(sectorSeed, 'thing', n);
+
+// A murmur3-style finaliser over four words; no BigInt, so 8,000 cells stay cheap.
+function mix(a, b, c, d) {
+  let h = Math.imul(a ^ 0x9e3779b9, 0x85ebca6b) ^ b;
+  h = Math.imul(h ^ (h >>> 16), 0x85ebca6b) ^ c;
+  h = Math.imul(h ^ (h >>> 13), 0xc2b2ae35) ^ d;
+  h = Math.imul(h ^ (h >>> 16), 0x85ebca6b);
+  h = Math.imul(h ^ (h >>> 13), 0xc2b2ae35);
+  return (h ^ (h >>> 16)) >>> 0;
+}
+const unit = (a, b, c, d) => mix(a, b, c, d) / 4294967296;
+
+const key = (bx, by, bz) => (bx + 1000) * 4000000 + (by + 1000) * 2000 + (bz + 1000);
+
+// Per ctx and kinds, the parts worth doing once: the seed halves, the total
+// weight and a coarse bucket grid of the systems. A pure cache, so the order
+// of asking changes nothing.
+const prepared = new WeakMap();
+function prepare(ctx, kinds) {
+  let byKinds = prepared.get(ctx);
+  if (!byKinds) prepared.set(ctx, (byKinds = new Map()));
+  let p = byKinds.get(kinds);
+  if (p) return p;
+  const seed = BigInt(ctx.seed);
+  const maxSize = Math.max(...kinds.map((k) => k.size[1]));
+  const grid = new Map();
+  const [ox, oy, oz] = ctx.origin;
+  for (const s of ctx.systems) {
+    const reach = (s.reach ?? systemReach(s)) + maxSize;
+    const e = [s.at[0] - ox, s.at[1] - oy, s.at[2] - oz];
+    if (e.some((v) => Math.abs(v) - reach > SKIN)) continue;
+    const lo = e.map((v) => Math.floor((v - reach) / BUCKET));
+    const hi = e.map((v) => Math.floor((v + reach) / BUCKET));
+    const row = { at: s.at, reach: reach - maxSize };
+    for (let x = lo[0]; x <= hi[0]; x++)
+      for (let y = lo[1]; y <= hi[1]; y++)
+        for (let z = lo[2]; z <= hi[2]; z++) {
+          const k = key(x, y, z);
+          const list = grid.get(k);
+          if (list) list.push(row);
+          else grid.set(k, [row]);
+        }
+  }
+  p = {
+    h0: Number(seed & 0xffffffffn) | 0,
+    h1: Number((seed >> 32n) & 0xffffffffn) | 0,
+    total: kinds.reduce((t, k) => t + k.weight, 0),
+    grid,
+  };
+  byKinds.set(kinds, p);
+  return p;
+}
+
+function cell(ctx, p, kinds, slot) {
+  const { h0, h1 } = p;
+  let r = unit(h0, h1, slot, 1) * p.total;
+  let ki = kinds.length - 1;
+  for (let i = 0; i < kinds.length; i++) {
+    if ((r -= kinds[i].weight) <= 0) {
+      ki = i;
+      break;
+    }
+  }
+  const [least, most] = kinds[ki].size;
+  const size = least + unit(h0, h1, slot, 2) * (most - least);
+  const ix = slot % THING_CELLS;
+  const iy = Math.floor(slot / THING_CELLS) % THING_CELLS;
+  const iz = Math.floor(slot / (THING_CELLS * THING_CELLS));
+  const jit = THING_JITTER * HALF;
+  const rel = [ix, iy, iz].map(
+    (c, a) => -SECTOR / 2 + HALF + CELL * c + (unit(h0, h1, slot, 3 + a) * 2 - 1) * jit,
+  );
+  let at = [ctx.origin[0] + rel[0], ctx.origin[1] + rel[1], ctx.origin[2] + rel[2]];
+  const place = kinds[ki].place;
+  if (place) {
+    at = place({ slot, kind: kinds[ki].kind, at, size }, ctx);
+    if (!at) return null;
+  }
+  if (!clearOfKeepOuts(at, (THING_NEAR + 1) * size, ctx.outs ?? [])) return null;
+  const near = p.grid.get(
+    key(
+      Math.floor((at[0] - ctx.origin[0]) / BUCKET),
+      Math.floor((at[1] - ctx.origin[1]) / BUCKET),
+      Math.floor((at[2] - ctx.origin[2]) / BUCKET),
+    ),
+  );
+  if (near) {
+    for (const s of near) {
+      const dx = at[0] - s.at[0];
+      const dy = at[1] - s.at[1];
+      const dz = at[2] - s.at[2];
+      const min = s.reach + size;
+      if (dx * dx + dy * dy + dz * dz < min * min) return null;
+    }
+  }
+  return {
+    kind: ki,
+    at: [at[0] - ctx.origin[0], at[1] - ctx.origin[1], at[2] - ctx.origin[2]],
+    size,
+  };
+}
+
+export function thingInCell(ctx, slot, kinds = THING_KINDS) {
+  return cell(ctx, prepare(ctx, kinds), kinds, slot);
+}
+
+export function thingsOf(ctx, extras = SECTOR_EXTRAS, kinds = THING_KINDS) {
+  const p = prepare(ctx, kinds);
+  const slot = new Uint16Array(SLOTS);
+  const kind = new Uint8Array(SLOTS);
+  const at = new Float32Array(SLOTS * 3);
+  const size = new Float32Array(SLOTS);
+  let count = 0;
+  for (let s = 0; s < SLOTS; s++) {
+    const t = cell(ctx, p, kinds, s);
+    if (!t) continue;
+    slot[count] = s;
+    kind[count] = t.kind;
+    at.set(t.at, count * 3);
+    size[count] = t.size;
+    count++;
+  }
+  const things = {
+    count,
+    slot: slot.slice(0, count),
+    kind: kind.slice(0, count),
+    at: at.slice(0, count * 3),
+    size: size.slice(0, count),
+  };
+  const lists = {};
+  for (const e of extras) {
+    if (e.base + e.max > THING_BASE) throw new Error(`extra ${e.list} reaches into the lattice's ids`);
+    lists[e.list] = e
+      .make(ctx)
+      .slice(0, e.max)
+      .map((row, k) => ({ ...row, id: spaceId([ctx.sx, ctx.sy, ctx.sz], { wonder: e.base + k }) }));
+  }
+  return { things, extras: lists };
+}
+
+export function thingRow(sector, i) {
+  const t = sector.things;
+  const n = THING_BASE + t.slot[i];
+  const seed = thingSeed(sector.seed, n);
+  const name = nameOf(rngOf(seed), 'core');
+  return {
+    id: spaceId([sector.sx, sector.sy, sector.sz], { wonder: n }),
+    n,
+    kind: THING_KINDS[t.kind[i]].kind,
+    at: [
+      sector.origin[0] + t.at[i * 3],
+      sector.origin[1] + t.at[i * 3 + 1],
+      sector.origin[2] + t.at[i * 3 + 2],
+    ],
+    size: t.size[i],
+    seed,
+    name: name[0].toUpperCase() + name.slice(1),
+  };
+}
diff --git a/src/components/expanse/gen/things.test.js b/src/components/expanse/gen/things.test.js
new file mode 100644
index 000000000..a66ddbd55
--- /dev/null
+++ b/src/components/expanse/gen/things.test.js
@@ -0,0 +1,186 @@
+import { describe, expect, it } from "vitest";
+import { parseSpaceId, sectorCentre } from "../../../lib/space/address.js";
+import { keepOutsNear } from "./keepOuts";
+import { UNIVERSE, sectorSeedOf } from "./seed";
+import { makeSector } from "./sector";
+import { addBodies, systemReach } from "./systems";
+import {
+  SECTOR_EXTRAS,
+  THING_BASE,
+  THING_CELLS,
+  THING_JITTER,
+  THING_KINDS,
+  THING_NEAR,
+  thingInCell,
+  thingRow,
+  thingSeed,
+  thingsOf,
+} from "./things";
+
+const build = (sx, sz) => {
+  const sector = addBodies(makeSector(UNIVERSE, sx, sz));
+  const origin = sectorCentre(sx, 0, sz);
+  const seed = sectorSeedOf(UNIVERSE, sx, 0, sz);
+  return {
+    sx,
+    sy: 0,
+    sz,
+    origin,
+    seed,
+    systems: sector.systems,
+    outs: keepOutsNear(sx, 0, sz),
+  };
+};
+const ctx = build(3, -2);
+const set = thingsOf(ctx).things;
+const CELL = 6000;
+
+describe("constants and kinds", () => {
+  it("holds the brief's values", () => {
+    expect([THING_BASE, THING_CELLS, THING_JITTER, THING_NEAR]).toEqual([64, 20, 0.8, 8]);
+    expect(SECTOR_EXTRAS).toEqual([]);
+  });
+  it("has four valid kinds", () => {
+    expect(THING_KINDS.map((k) => k.kind)).toEqual(["rock", "ice", "derelict", "rogue"]);
+    for (const k of THING_KINDS) {
+      expect(k.weight).toBeGreaterThan(0);
+      expect(k.size[0]).toBeLessThan(k.size[1]);
+      expect(k.look.color).toMatch(/^#[0-9a-f]{6}$/);
+      expect(k.look.lit).toBe(true);
+    }
+  });
+});
+
+describe("thingsOf", () => {
+  it("fills the lattice, slots unique and ascending", () => {
+    expect(set.count).toBeGreaterThan(1000);
+    expect(set.count).toBeLessThanOrEqual(8000);
+    for (let i = 1; i < set.count; i++) expect(set.slot[i]).toBeGreaterThan(set.slot[i - 1]);
+  });
+  it("keeps each thing near its cell's centre, in a known kind and size", () => {
+    for (let i = 0; i < set.count; i++) {
+      const s = set.slot[i];
+      const cell = [s % 20, Math.floor(s / 20) % 20, Math.floor(s / 400)];
+      for (let a = 0; a < 3; a++) {
+        const c = -60000 + 3000 + CELL * cell[a];
+        expect(Math.abs(set.at[i * 3 + a] - c)).toBeLessThanOrEqual(0.8 * 3000 + 0.01);
+      }
+      const k = THING_KINDS[set.kind[i]];
+      expect(set.size[i]).toBeGreaterThanOrEqual(k.size[0] - 0.01);
+      expect(set.size[i]).toBeLessThanOrEqual(k.size[1] + 0.01);
+    }
+  });
+  it("leaves keep-outs and systems clear", () => {
+    const reach = ctx.systems.map(systemReach);
+    for (let i = 0; i < set.count; i++) {
+      const p = [0, 1, 2].map((a) => ctx.origin[a] + set.at[i * 3 + a]);
+      for (const k of ctx.outs) {
+        const d = Math.hypot(p[0] - k.at[0], p[1] - k.at[1], p[2] - k.at[2]);
+        expect(d).toBeGreaterThanOrEqual(k.r + (THING_NEAR + 1) * set.size[i] - 0.5);
+      }
+      ctx.systems.forEach((s, j) => {
+        const d = Math.hypot(p[0] - s.at[0], p[1] - s.at[1], p[2] - s.at[2]);
+        expect(d).toBeGreaterThanOrEqual(reach[j] + set.size[i] - 0.5);
+      });
+    }
+  });
+  it("is the same on a second build", () => {
+    const again = thingsOf(build(3, -2)).things;
+    expect(again.count).toBe(set.count);
+    expect(Array.from(again.at)).toEqual(Array.from(set.at));
+  });
+  it("gives any cell alone what the full list gives, in any order", () => {
+    const fresh = build(3, -2);
+    const bySlot = new Map();
+    for (let i = 0; i < set.count; i++) bySlot.set(set.slot[i], i);
+    for (let n = 0; n < 50; n++) {
+      const slot = 7999 - ((n * 157 + 13) % 8000);
+      const one = thingInCell(fresh, slot);
+      const i = bySlot.get(slot);
+      if (i === undefined) expect(one).toBeNull();
+      else {
+        expect(one.kind).toBe(set.kind[i]);
+        expect(one.size).toBeCloseTo(set.size[i], 2);
+        for (let a = 0; a < 3; a++) expect(one.at[a]).toBeCloseTo(set.at[i * 3 + a], 2);
+      }
+    }
+  });
+  it("is fast enough", () => {
+    const c = build(-4, 5);
+    const t = performance.now();
+    thingsOf(c);
+    expect(performance.now() - t).toBeLessThan(200);
+  });
+});
+
+describe("thingRow", () => {
+  const sector = { ...ctx, things: set };
+  it("names, ids and seeds a thing", () => {
+    for (const i of [0, 1, set.count - 1]) {
+      const row = thingRow(sector, i);
+      expect(parseSpaceId(row.id).wonder).toBe(THING_BASE + set.slot[i]);
+      expect(row.n).toBe(THING_BASE + set.slot[i]);
+      expect(row.seed).toBe(thingSeed(ctx.seed, row.n));
+      expect(row.name).toMatch(/^[A-Z]/);
+      expect(row.kind).toBe(THING_KINDS[set.kind[i]].kind);
+      expect(Math.abs(row.at[0] - (ctx.origin[0] + set.at[i * 3]))).toBeLessThan(0.01);
+    }
+  });
+});
+
+describe("hooks", () => {
+  it("keeps the first max rows of an extra, with ids from base", () => {
+    const a = { kind: "rock", at: [0, 0, 0], size: 1 };
+    const out = thingsOf(ctx, [{ list: "test", base: 3, max: 2, make: () => [a, a, a] }]);
+    expect(out.extras.test).toHaveLength(2);
+    expect(out.extras.test.map((r) => r.id.split(":").pop())).toEqual(["w3", "w4"]);
+  });
+  it("refuses an extra that reaches into the lattice's ids", () => {
+    expect(() => thingsOf(ctx, [{ list: "x", base: 63, max: 2, make: () => [] }])).toThrow();
+  });
+  it("drops a site whose kind's place gives null, and moves one it moves", () => {
+    const kinds = [{ ...THING_KINDS[0], place: () => null }];
+    expect(thingsOf(ctx, [], kinds).things.count).toBe(0);
+    const moved = [{ ...THING_KINDS[0], place: (site) => [site.at[0], site.at[1] + 1, site.at[2]] }];
+    const plain = [THING_KINDS[0]];
+    const a = thingInCell(ctx, 4000, plain);
+    const b = thingInCell(ctx, 4000, moved);
+    expect(a).not.toBeNull();
+    expect(b.at[1] - a.at[1]).toBeCloseTo(1, 2);
+  });
+});
+
+describe("clearance, forced", () => {
+  const home = build(0, 0);
+  const homeSet = thingsOf(home).things;
+  it("removes slots near the home keep-out, and the rest clear it", () => {
+    expect(home.outs.length).toBeGreaterThan(0);
+    expect(homeSet.count).toBeLessThan(8000);
+    for (let i = 0; i < homeSet.count; i++) {
+      const p = [0, 1, 2].map((a) => home.origin[a] + homeSet.at[i * 3 + a]);
+      for (const k of home.outs) {
+        const d = Math.hypot(p[0] - k.at[0], p[1] - k.at[1], p[2] - k.at[2]);
+        expect(d).toBeGreaterThanOrEqual(k.r + (THING_NEAR + 1) * homeSet.size[i] - 0.5);
+      }
+    }
+  });
+  const slot = 4210;
+  const free = thingInCell({ ...ctx, systems: [], outs: [] }, slot);
+  const spot = free && free.at.map((v, a) => ctx.origin[a] + v);
+  it("has a free site to aim at", () => {
+    expect(free).not.toBeNull();
+  });
+  it("drops a thing whose site is inside a system's reach", () => {
+    const hit = { ...ctx, outs: [], systems: [{ at: spot, reach: 1 }] };
+    expect(thingInCell(hit, slot)).toBeNull();
+    const miss = { ...ctx, outs: [], systems: [{ at: spot.map((v) => v + 5000), reach: 1 }] };
+    expect(thingInCell(miss, slot)).not.toBeNull();
+    expect(thingsOf(hit).things.slot).not.toContain(slot);
+  });
+  it("drops a thing whose site is inside a keep-out", () => {
+    const hit = { ...ctx, systems: [], outs: [{ id: "t", at: spot, r: 1 }] };
+    expect(thingInCell(hit, slot)).toBeNull();
+    const miss = { ...ctx, systems: [], outs: [{ id: "t", at: spot.map((v) => v + 5000), r: 1 }] };
+    expect(thingInCell(miss, slot)).not.toBeNull();
+  });
+});
