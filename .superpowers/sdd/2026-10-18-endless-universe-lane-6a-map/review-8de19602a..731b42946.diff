+  const corner = (x, y) => Math.hypot(x - bounds.cx, y - bounds.cy) <= bounds.r;
+  return corner(b.x0, b.y0) && corner(b.x1, b.y0) && corner(b.x0, b.y1) && corner(b.x1, b.y1);
+}
 
