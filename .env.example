# Copy to .env.local (never committed). Both are optional.
# Without them /fly plays with no durable layer (nothing built is kept). # planet flight
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The buckets on Cloudflare R2 (scripts/lib/bucket.mjs): R2's S3 keys (R2 →
# Manage API tokens: the Access Key ID and the Secret Access Key it shows
# once), for the Battlefront 2017 drop in bf2017-assets (scripts/bf2017-fetch.mjs)
# and the uploads to the public tilak-assets (scripts/assets-publish.mjs, assets-upload.mjs).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The public bucket (tilak-assets on R2): where the heavy models and textures are asked
# first, and where the game-derived files live: its own domain,
# https://assets.tilakpatell.com. Read with no key. Optional: without it every
# file comes from the site.
VITE_ASSET_BASE=
# The Battlefront world's dev backend (src/components/battlefront/assets.js):
# the local export's root (its web_opt/ or web/ is served at /bf2/ by
# scripts/bf2-dev.mjs), and which backend the page reads (dev or bucket).
BF2_ROOT=
VITE_BF2_BACKEND=dev
