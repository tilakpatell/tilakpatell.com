# Copy to .env.local (never committed). Both are optional: the asset mirror reads the URL.
# Without them /fly plays with no durable layer (nothing built is kept). # planet flight
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The Battlefront 2017 drop (scripts/bf2017-fetch.mjs): the project URL and a key that can read the bf2017-assets bucket.
SUPABASE_URL=
BF2017_KEY=
# The public bucket site-assets: where the heavy models and textures are asked
# first, and where the game-derived files live (scripts/assets-publish.mjs
# prints it: https://<ref>.supabase.co/storage/v1/object/public/site-assets).
# Read with no key. Optional: without it every file comes from the site.
# Never put the secret key here or in any file.
VITE_ASSET_BASE=
# The Battlefront world's dev backend (src/components/battlefront/assets.js):
# the local export's root (its web_opt/ or web/ is served at /bf2/ by
# scripts/bf2-dev.mjs), and which backend the page reads (dev or bucket).
BF2_ROOT=
VITE_BF2_BACKEND=dev
