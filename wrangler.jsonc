// The site on Cloudflare: the Worker tilakpatell-com, nothing but the build's
// files (no script of its own), uploaded by .github/workflows/deploy.yml
// after GitHub Pages (docs/decisions/2026-10-21-cloudflare-for-the-site.md).
// A path with no file answers with dist/404.html, as GitHub Pages does; a
// folder's index.html answers at its path with the slash; public/_headers
// holds the cache rule.
{
  "name": "tilakpatell-com",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  // (one address, the workers.dev one: no address for each version uploaded)
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
